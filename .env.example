# Copy this file to ".env" and paste in your Supabase project values.
# Both of these are SAFE to ship in a frontend — the anon key is public by design
# (row-level security is what protects the data). NEVER put the service_role key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Show Learn article reviewer and review dates after clinical review is complete.
VITE_SHOW_LEARN_CONTENT_REVIEW=false

# Product features. Riskier health-history features remain off until review.
VITE_FEATURE_FOOD=true
VITE_FEATURE_ROUTE_SUMMARY=true
VITE_FEATURE_ROUTE_CARE=true
VITE_FEATURE_ROUTE_CARE_REVIEWED=false
VITE_FEATURE_PERIODIC_CHECKINS=false
VITE_FEATURE_HISTORY_CAPTURE=false
VITE_FEATURE_HISTORY_MODIFIERS=false
VITE_FEATURE_ROUTE_WHO=true
VITE_FEATURE_COMPOUND_FLAGS=false

# Leave both blank/unset for an on-device guest tracker.
# Apply the SQL in supabase/setup before deploying this version.
