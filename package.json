{
  "name": "maisie-health",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Maisie Health, teen health navigation for understanding concerns, preparing for care, and finding the right next step without diagnosing conditions.",
  "scripts": {
    "test": "node --test src/content/*.test.js src/content/learn/*.test.js src/engine/*.test.js src/lib/*.test.js src/state/*.test.mjs",
    "dev": "vite",
    "build": "node --test src/content/learn/articles.test.js && vite build",
    "preview": "vite preview",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:assets": "capacitor-assets generate --ios --iconBackgroundColor '#FAF7FB' --iconBackgroundColorDark '#FAF7FB' --splashBackgroundColor '#FAF7FB' --splashBackgroundColorDark '#FAF7FB' --logoSplashTargetWidth 640"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.6",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.110.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
